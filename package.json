{
  "name": "kinagent",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.js",
  "author": "TheBigDumbSwede",
  "description": "Headless Kindroid to Hermes bridge prototype.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-desktop-assets.mjs",
    "desktop": "npm run build && electron dist/desktop/main.js",
    "postinstall": "playwright install chromium",
    "login": "tsx src/index.ts login",
    "instrument-login": "tsx src/index.ts instrument-login",
    "list-kins": "tsx src/index.ts list-kins",
    "list-groups": "tsx src/index.ts list-groups",
    "probe-group-chat": "tsx src/index.ts probe-group-chat",
    "session-info": "tsx src/index.ts session-info",
    "probe-chat": "tsx src/index.ts probe-chat",
    "capture-state": "tsx src/index.ts capture-state",
    "monitor-live": "tsx src/index.ts monitor-live",
    "listen": "tsx src/index.ts listen",
    "send": "tsx src/index.ts send",
    "ambient-context": "tsx src/index.ts ambient-context",
    "chat-dynamism": "tsx src/index.ts chat-dynamism",
    "experiment:chat-dynamism": "tsx src/index.ts experiment-chat-dynamism",
    "experiment:internet-response": "tsx src/index.ts experiment-internet-response",
    "daemon": "tsx src/index.ts daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "secret-scan": "node scripts/secret-scan.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "smoke:desktop": "npm run build && node scripts/desktop-smoke.mjs",
    "dist:win": "node scripts/dist-win.mjs",
    "release:check-version": "node scripts/check-release-version.mjs",
    "smoke:portable": "node scripts/smoke-portable.mjs",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "npm run secret-scan && npm run lint && npm run format && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "build": {
    "appId": "dev.kinagent.app",
    "productName": "Kinagent",
    "icon": "assets/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist/desktop/main.js"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Kinagent-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@types/crypto-js": "^4.2.2",
    "commander": "^14.0.2",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "playwright": "^1.57.0",
    "protobufjs": "^7.6.2",
    "sql.js": "^1.14.1",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/sql.js": "^1.4.11",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
