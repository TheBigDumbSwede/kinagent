{
  "manifest_version": 3,
  "name": "Kinagent Browser Bridge",
  "version": "0.1.0",
  "description": "Connects Kindroid browser tabs to the local Kinagent desktop app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://kindroid.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kindroid.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kinagent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kinagent-browser-bridge@kinagent.local",
      "strict_min_version": "109.0"
    }
  }
}
