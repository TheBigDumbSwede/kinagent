# Optional. If omitted, config.yaml is used where possible.
KINAGENT_CONFIG=./config.yaml

KINDROID_FIREBASE_PROJECT_ID=kindroid-ai
KINDROID_UID=

BRIDGE_DEDUPE_WINDOW_SECONDS=180
BRIDGE_LOG_PATH=./data/kinagent.log
BRIDGE_LOG_LEVEL=info
BRIDGE_SESSION_DIR=./data/browser-session
BRIDGE_SQLITE_PATH=./data/bridge.sqlite

HERMES_ENABLED=false
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_AGENT_ID=kindroid-bridge
HERMES_CURRENT_SCENE_UPDATES_ENABLED=true
HERMES_CURRENT_SCENE_MAX_LENGTH=160
HERMES_JOURNAL_SUGGESTIONS_ENABLED=true
HERMES_JOURNAL_SUGGESTION_THROTTLE_MESSAGES=20
HERMES_JOURNAL_STRONG_EVENT_BYPASS=true

# Optional desktop-only voice sidecar secrets. Enable voice and choose a provider in config.yaml.
KINAGENT_OPENAI_API_KEY=
KINAGENT_OPENAI_TTS_MODEL=gpt-4o-mini-tts
KINAGENT_OPENAI_TTS_VOICE=marin
KINAGENT_OPENAI_TTS_INSTRUCTIONS=
KINAGENT_ELEVENLABS_API_KEY=
KINAGENT_ELEVENLABS_MODEL=eleven_flash_v2_5
KINAGENT_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
